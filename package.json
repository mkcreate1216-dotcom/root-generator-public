{
  "name": "tabi-ori",
  "type": "module",
  "version": "1.0.0",
  "description": "たびおり - 予定を縦糸に、想い出を横糸に。旅を織る。",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:specs": "node ./scripts/verify-specs.mjs",
    "check": "node ./scripts/verify-specs.mjs && tsc --noEmit",
    "astro": "astro",
    "d1:apply:local": "wrangler d1 execute tabiori-db --local --file=./db/schema.sql",
    "d1:apply:remote": "wrangler d1 execute tabiori-db --remote --file=./db/schema.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^11.2.0",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^4.16.18",
    "lucide": "^0.469.0",
    "lz-string": "^1.5.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
