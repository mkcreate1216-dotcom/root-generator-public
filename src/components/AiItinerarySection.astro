---
// AIで旅程を作成・更新するための統合UI
// 一般ユーザー向けのコピペフローをメインにし、MCP連携はアコーディオンで下部に配置
---

<div class="space-y-6" id="ai-itinerary-section">
  <!-- ステップ1: プロンプト作成・コピー -->
  <section class="border border-slate-200 rounded-2xl p-4 sm:p-5 bg-white">
    <h3 class="font-bold text-slate-800 mb-3 flex items-center gap-2">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-blue-100 text-blue-700 text-xs font-bold">1</span>
      AIへの指示文を作成・コピー
    </h3>
    <textarea
      id="ai-request-input"
      class="w-full border border-slate-200 rounded-xl p-3 text-sm min-h-[80px] focus:outline-none focus:ring-2 focus:ring-blue-300"
      placeholder="例：2日目の昼に海鮮ランチを追加して、全体的にゆったりめにして"
    ></textarea>
    <button
      id="ai-copy-prompt-btn"
      type="button"
      class="mt-3 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl transition-colors"
    >
      AIへの指示文をコピー
    </button>
    <p id="ai-copy-feedback" class="mt-2 text-xs text-emerald-600 hidden">コピーしました！</p>
  </section>

  <!-- ステップ2: 出力結果を貼り付けて反映 -->
  <section class="border border-slate-200 rounded-2xl p-4 sm:p-5 bg-white">
    <h3 class="font-bold text-slate-800 mb-3 flex items-center gap-2">
      <span class="flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 text-xs font-bold">2</span>
      AIの出力結果を貼り付けて旅程を反映
    </h3>
    <textarea
      id="ai-output-input"
      class="w-full border border-slate-200 rounded-xl p-3 text-sm min-h-[120px] focus:outline-none focus:ring-2 focus:ring-emerald-300 font-mono text-xs"
      placeholder="AIが出力したテキストをここに貼り付けてください"
    ></textarea>
    <button
      id="ai-apply-btn"
      type="button"
      class="mt-3 px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold rounded-xl transition-colors"
    >
      旅程を反映する
    </button>
    <p id="ai-apply-feedback" class="mt-2 text-xs hidden"></p>
  </section>

  <!-- ステップ3: 上級者向け MCP連携（アコーディオン） -->
  <div class="border border-slate-200 rounded-2xl overflow-hidden">
    <button
      id="mcp-accordion-toggle"
      type="button"
      class="w-full flex items-center justify-between p-4 text-left hover:bg-slate-50 transition-colors"
    >
      <span class="flex items-center gap-2 font-medium text-slate-700">
        <span>⚡</span>
        <span>上級者向け：MCP連携で直接つなぐ（Claude Desktop等）</span>
        <span class="text-[10px] bg-slate-200 text-slate-600 px-1.5 py-0.5 rounded">上級者</span>
      </span>
      <span id="mcp-accordion-icon" class="text-slate-400">▼</span>
    </button>
    <div id="mcp-accordion-content" class="hidden p-4 border-t border-slate-100">
      <p class="text-xs text-slate-500 mb-3">
        上級者向けの直接連携です。一般的な使用では上のコピペフローで十分です。
      </p>
      <!-- 既存のMCPモーダルを呼び出すボタンを配置する想定 -->
      <button
        type="button"
        class="px-4 py-2 bg-slate-800 text-white text-xs font-semibold rounded-lg"
        onclick="window.openTabiromeMcpModal && window.openTabiromeMcpModal()"
      >
        MCP連携設定を開く
      </button>
    </div>
  </div>
</div>

<script>
  // 型に合わせた最小限の1行サンプル（Minified）
  const SCHEMA_SAMPLE = '{"tripName":"旅行タイトル","days":[{"name":"1日目","spots":[{"name":"スポット名","memo":"メモ"}],"accommodation":"宿泊先","autoAccommodation":false,"autoStart":false,"autoStartSlot":false,"autoStartValue":""}],"departure":"出発地","arrival":"到着地","autoArrival":false,"mapType":"google","activeDayIndex":0}';

  const requestInput = document.getElementById('ai-request-input') as HTMLTextAreaElement;
  const copyBtn = document.getElementById('ai-copy-prompt-btn');
  const copyFeedback = document.getElementById('ai-copy-feedback');
  const outputInput = document.getElementById('ai-output-input') as HTMLTextAreaElement;
  const applyBtn = document.getElementById('ai-apply-btn');
  const applyFeedback = document.getElementById('ai-apply-feedback');
  const accordionToggle = document.getElementById('mcp-accordion-toggle');
  const accordionContent = document.getElementById('mcp-accordion-content');
  const accordionIcon = document.getElementById('mcp-accordion-icon');

  // アコーディオン
  accordionToggle?.addEventListener('click', () => {
    const isOpen = !accordionContent?.classList.contains('hidden');
    if (isOpen) {
      accordionContent?.classList.add('hidden');
      if (accordionIcon) accordionIcon.textContent = '▼';
    } else {
      accordionContent?.classList.remove('hidden');
      if (accordionIcon) accordionIcon.textContent = '▲';
    }
  });

  // 現在の旅程データを取得する関数（アプリの状態に応じて調整が必要）
  function getCurrentItinerary(): any | null {
    // TODO: 実際のアプリの状態取得ロジックに置き換える
    // 例: return (window as any).getCurrentTrip?.() || null;
    try {
      const stored = localStorage.getItem('tabirome_current_trip');
      return stored ? JSON.parse(stored) : null;
    } catch {
      return null;
    }
  }

  // プロンプト生成・コピー
  copyBtn?.addEventListener('click', async () => {
    const userRequest = requestInput?.value.trim() || '旅行の旅程を作成してください。';
    const current = getCurrentItinerary();

    let prompt = `以下の要望に沿って旅行の旅程を作成・更新し、指定のデータ形式（コードブロックのみ、前後の挨拶や解説は一切不要）で出力してください。\n\n【要望】\n${userRequest}`;

    if (current) {
      // 不要な内部プロパティを除外してMinify
      const clean = {
        tripName: current.tripName || current.title,
        days: current.days,
        departure: current.departure,
        arrival: current.arrival,
        autoArrival: current.autoArrival,
        mapType: current.mapType,
        activeDayIndex: current.activeDayIndex ?? 0,
      };
      prompt += `\n\n【現在の旅程データ（これをベースに更新してください）】\n${JSON.stringify(clean)}`;
    }

    prompt += `\n\n【出力データ形式（この構造を厳守し1つのJSONとして出力）】\n${SCHEMA_SAMPLE}`;

    try {
      await navigator.clipboard.writeText(prompt);
      if (copyFeedback) {
        copyFeedback.classList.remove('hidden');
        setTimeout(() => copyFeedback.classList.add('hidden'), 2000);
      }
    } catch {
      alert('コピーに失敗しました');
    }
  });

  // JSON抽出
  function extractJson(text: string): string | null {
    const codeBlock = text.match(/```(?:json)?\s*([\s\S]*?)```/);
    if (codeBlock) return codeBlock[1].trim();

    const start = text.indexOf('{');
    const end = text.lastIndexOf('}');
    if (start !== -1 && end !== -1 && end > start) {
      return text.slice(start, end + 1);
    }
    return null;
  }

  // 反映
  applyBtn?.addEventListener('click', () => {
    const jsonStr = extractJson(outputInput?.value || '');
    if (!jsonStr) {
      if (applyFeedback) {
        applyFeedback.textContent = 'うまく読み込めませんでした。AIが出力したテキストをすべてコピーして貼り付けてください';
        applyFeedback.className = 'mt-2 text-xs text-rose-600';
        applyFeedback.classList.remove('hidden');
      }
      return;
    }

    try {
      const parsed = JSON.parse(jsonStr);
      if (!parsed.days || !Array.isArray(parsed.days)) {
        throw new Error('invalid');
      }

      // TODO: 実際のアプリの保存ロジックに置き換える
      // 例: (window as any).updateTrip?.(parsed);
      localStorage.setItem('tabirome_current_trip', JSON.stringify(parsed));

      if (applyFeedback) {
        applyFeedback.textContent = '旅程を反映しました';
        applyFeedback.className = 'mt-2 text-xs text-emerald-600';
        applyFeedback.classList.remove('hidden');
      }
      if (outputInput) outputInput.value = '';

      // 画面を更新するためにリロード（本番では状態管理に合わせて調整）
      setTimeout(() => location.reload(), 800);
    } catch {
      if (applyFeedback) {
        applyFeedback.textContent = 'うまく読み込めませんでした。AIが出力したテキストをすべてコピーして貼り付けてください';
        applyFeedback.className = 'mt-2 text-xs text-rose-600';
        applyFeedback.classList.remove('hidden');
      }
    }
  });
</script>
