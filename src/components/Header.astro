---
---

<header class="p-5 pb-0">
  <div class="flex flex-wrap items-start justify-between gap-3 sm:items-center">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">たびおり</h1>
      <p class="mt-1 text-sm text-slate-600">予定を縦糸に、想い出を横糸に。旅を織る。</p>
    </div>
    <div class="flex items-center gap-2" id="header-map-selector-container">
      <div
        id="map-selector-group"
        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white p-1 text-xs font-medium text-slate-700 shadow-xs"
        role="radiogroup"
        aria-label="地図アプリ選択"
      >
        <span class="flex items-center gap-1 pl-1.5 pr-0.5 text-slate-500 select-none" title="地図アプリ選択">
          <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
            <line x1="9" x2="9" y1="3" y2="18"/>
            <line x1="15" x2="15" y1="6" y2="21"/>
          </svg>
          <span class="text-xs font-medium text-slate-600">マップ</span>
        </span>
        <div class="inline-flex items-center rounded-md bg-slate-100 p-0.5">
          <label
            class="map-type-label flex cursor-pointer items-center rounded px-2 py-1 text-xs font-medium transition-all select-none bg-white text-slate-900 shadow-xs"
            data-map-type="google"
          >
            <input type="radio" name="map-type-radio" value="google" class="sr-only" checked />
            <span>Google</span>
          </label>
          <label
            class="map-type-label flex cursor-pointer items-center rounded px-2 py-1 text-xs font-medium transition-all select-none text-slate-500 hover:text-slate-900"
            data-map-type="apple"
          >
            <input type="radio" name="map-type-radio" value="apple" class="sr-only" />
            <span>Apple</span>
          </label>
        </div>
      </div>
    </div>
  </div>
</header>

