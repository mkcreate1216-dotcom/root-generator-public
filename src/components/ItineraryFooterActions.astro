---
---

<!-- 旅程下部のバックアップ出力・保存期間案内・削除セクション -->
<div id="itinerary-lifecycle-section" class="mt-6 mb-4 clay-sunken rounded-2xl p-4 sm:p-5">
  <div class="flex flex-col gap-3.5">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div>
        <h3 class="text-xs sm:text-sm font-bold text-slate-800 flex items-center gap-1.5">
          <svg class="h-4 w-4 text-slate-600 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>旅程の保存・バックアップ出力</span>
        </h3>
        <p class="mt-1 text-[11px] sm:text-xs text-slate-500 leading-relaxed">
          共有リンク（クラウド保存）された旅程は<strong class="font-semibold text-slate-700">最終更新から90日間</strong>保存され、90日経過後に自動削除されます。手元に控えを残す場合は画像またはテキストで保存してください。
        </p>
      </div>
    </div>

    <!-- 出力・削除アクションボタン群 -->
    <div class="flex flex-wrap items-center justify-between gap-2 pt-1">
      <div class="flex flex-wrap items-center gap-2">
        <button
          id="export-image-btn"
          type="button"
          class="clay-btn-dark inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold text-white cursor-pointer transition-all duration-75"
        >
          <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
            <circle cx="9" cy="9" r="2"/>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
          </svg>
          <span>画像で保存 (.png)</span>
        </button>

        <button
          id="export-text-btn"
          type="button"
          class="clay-btn inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 cursor-pointer transition-all duration-75"
        >
          <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <line x1="10" y1="9" x2="8" y2="9"/>
          </svg>
          <span>テキストで保存 (.txt)</span>
        </button>

        <button
          id="copy-itinerary-text-btn"
          type="button"
          class="clay-btn inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 cursor-pointer transition-all duration-75"
        >
          <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
          <span>テキストをコピー</span>
        </button>
      </div>

      <button
        id="open-delete-trip-btn"
        type="button"
        class="clay-btn inline-flex items-center gap-1.5 rounded-xl px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-50 hover:text-red-700 cursor-pointer transition-all duration-75 ml-auto"
      >
        <svg class="h-3.5 w-3.5 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 6h18"/>
          <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
          <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
        </svg>
        <span>この旅程を削除</span>
      </button>
    </div>
  </div>
</div>

<!-- 旅程削除確認モーダル（完全削除オプション付き） -->
<div
  id="delete-trip-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="delete-trip-modal-heading"
>
  <div class="clay-card w-full max-w-md rounded-3xl p-5 sm:p-6 shadow-xl">
    <div class="flex items-start justify-between gap-3">
      <h3 id="delete-trip-modal-heading" class="text-base sm:text-lg font-bold text-slate-900">
        旅程を削除しますか？
      </h3>
      <button
        id="delete-trip-close-btn"
        type="button"
        aria-label="閉じる"
        title="閉じる"
        class="rounded-full clay-btn p-1.5 text-slate-500 hover:text-slate-800 cursor-pointer"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 6 6 18"/>
          <path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

    <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed">
      「<span id="delete-trip-modal-name" class="font-bold text-slate-900"></span>」を削除します。この操作は取り消せません。
    </p>

    <!-- 共有済みプランの場合に表示するクラウド完全削除オプション -->
    <div id="delete-trip-cloud-option" class="hidden mt-4 clay-sunken rounded-2xl p-3.5">
      <label class="flex items-start gap-2.5 cursor-pointer select-none">
        <input
          id="delete-trip-cloud-checkbox"
          type="checkbox"
          checked
          class="mt-0.5 h-4 w-4 rounded border-slate-300 text-red-600 focus:ring-red-400 accent-slate-900 cursor-pointer shrink-0"
        />
        <span class="text-xs text-slate-700 leading-relaxed">
          <strong class="font-bold text-slate-900 block">クラウド上の共有データも完全に削除する</strong>
          <span class="text-[11px] text-slate-500 block mt-0.5">
            発行済みの共有URL（/p/...）も即座に無効になります。チェックを外すと、この端末の履歴からのみ削除されます。
          </span>
        </span>
      </label>
    </div>

    <div class="mt-5 flex items-center justify-end gap-2.5">
      <button
        id="delete-trip-cancel-btn"
        type="button"
        class="clay-btn rounded-xl px-4 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 cursor-pointer"
      >
        キャンセル
      </button>
      <button
        id="delete-trip-confirm-btn"
        type="button"
        class="rounded-xl bg-red-600 hover:bg-red-700 px-4 py-2 text-xs font-bold text-white shadow-sm cursor-pointer transition-colors"
      >
        削除
      </button>
    </div>
  </div>
</div>

