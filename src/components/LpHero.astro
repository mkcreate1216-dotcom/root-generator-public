---
---

<!-- 上部: タイトル・キャッチコピー -->
<div id="lp-hero-section" class="w-full text-center mb-4 sm:mb-5 transition-all duration-200">
  <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full clay-pill text-xs font-semibold text-slate-700 mb-3.5 select-none">
    <span>旅程作成アプリ</span>
  </div>

  <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-900 mb-2.5 select-none">
    たびろーむ
  </h1>

  <p class="text-sm sm:text-base font-medium text-slate-600 max-w-xl mx-auto leading-relaxed">
    道草を楽しむ、気ままな旅へ。
  </p>
</div>

<!-- 特徴3点（矢印なし、スポット登録、枠なし簡素表示） -->
<div id="lp-features-section" class="w-full max-w-lg mx-auto mb-5 sm:mb-6 transition-all duration-200">
  <div class="flex items-center justify-center gap-5 sm:gap-8 text-xs text-slate-500 select-none">
    <div class="flex items-center gap-2">
      <span class="flex h-5 w-5 items-center justify-center rounded-full clay-pill text-[10px] font-bold text-slate-800">1</span>
      <span class="font-medium text-slate-700">スポット登録</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="flex h-5 w-5 items-center justify-center rounded-full clay-pill text-[10px] font-bold text-slate-800">2</span>
      <span class="font-medium text-slate-700">ルート案内</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="flex h-5 w-5 items-center justify-center rounded-full clay-pill text-[10px] font-bold text-slate-800">3</span>
      <span class="font-medium text-slate-700">URL共有</span>
    </div>
  </div>
</div>

<!-- MCP連携クイック導線 & 地図アプリ選択 -->
<div id="lp-mcp-section" class="w-full flex items-center justify-center mb-6 sm:mb-7 transition-all duration-200">
  <button
    id="lp-mcp-open-btn"
    type="button"
    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full clay-btn text-xs font-semibold text-slate-700 hover:text-slate-900 border border-slate-200/60 shadow-sm transition-all cursor-pointer active:scale-95"
  >
    <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span>AI連携 (MCP)</span>
  </button>

  <div class="hidden items-center gap-2 transition-opacity duration-200 ml-auto" id="header-map-selector-container">
    <div
      id="map-selector-group"
      class="inline-flex items-center gap-1 rounded-2xl clay-pill p-1 text-xs font-medium text-slate-700"
      role="radiogroup"
      aria-label="地図アプリ選択"
    >
      <span class="flex items-center pl-2 pr-1 text-slate-500 select-none" title="地図アプリ選択">
        <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
          <line x1="9" x2="9" y1="3" y2="18"/>
          <line x1="15" x2="15" y1="6" y2="21"/>
        </svg>
      </span>
      <div class="inline-flex items-center rounded-xl clay-sunken p-0.5">
        <label
          class="map-type-label flex cursor-pointer items-center rounded-lg px-2.5 py-1 text-xs font-semibold transition-all select-none clay-btn text-slate-900"
          data-map-type="google"
        >
          <input type="radio" name="map-type-radio" value="google" class="sr-only" checked />
          <span>Google</span>
        </label>
        <label
          class="map-type-label flex cursor-pointer items-center rounded-lg px-2.5 py-1 text-xs font-medium transition-all select-none text-slate-500 hover:text-slate-900"
          data-map-type="apple"
        >
          <input type="radio" name="map-type-radio" value="apple" class="sr-only" />
          <span>Apple</span>
        </label>
      </div>
    </div>
  </div>
</div>

<script>
  const mcpBtn = document.getElementById('lp-mcp-open-btn');
  mcpBtn?.addEventListener('click', () => {
    if (typeof (window as any).openTabiromeMcpModal === 'function') {
      (window as any).openTabiromeMcpModal();
    }
  });
</script>

