---
---

<form
  id="add-spot-form"
  class="hidden w-full mt-2.5 pt-2.5 border-t border-slate-100 transition-all duration-200"
>

  <div class="mb-1.5 flex items-center justify-between gap-2">
    <label class="block text-xs font-medium text-slate-700" for="new-spot-input">スポット・地点を追加</label>
    <div class="hidden items-center gap-2 transition-opacity duration-200 ml-auto" id="header-map-selector-container">
      <div
        id="map-selector-group"
        class="inline-flex items-center gap-1 rounded-lg border border-slate-300 bg-white p-1 text-xs font-medium text-slate-700 shadow-xs"
        role="radiogroup"
        aria-label="地図アプリ選択"
      >
        <span class="flex items-center gap-1 pl-1.5 pr-0.5 text-slate-500 select-none" title="地図アプリ選択">
          <svg class="h-3.5 w-3.5 sm:h-4 sm:w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
            <line x1="9" x2="9" y1="3" y2="18"/>
            <line x1="15" x2="15" y1="6" y2="21"/>
          </svg>
          <span class="text-xs font-medium text-slate-600">マップ</span>
        </span>
        <div class="inline-flex items-center rounded-md bg-slate-100 p-0.5">
          <label
            class="map-type-label flex cursor-pointer items-center rounded px-2 py-1 text-xs font-medium transition-all select-none bg-white text-slate-900 shadow-xs"
            data-map-type="google"
          >
            <input type="radio" name="map-type-radio" value="google" class="sr-only" checked />
            <span>Google</span>
          </label>
          <label
            class="map-type-label flex cursor-pointer items-center rounded px-2 py-1 text-xs font-medium transition-all select-none text-slate-500 hover:text-slate-900"
            data-map-type="apple"
          >
            <input type="radio" name="map-type-radio" value="apple" class="sr-only" />
            <span>Apple</span>
          </label>
        </div>
      </div>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <input
      id="new-spot-input"
      type="text"
      placeholder="例: 浅草寺"
      class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none transition-colors duration-75 focus:border-slate-900 focus:ring-2 focus:ring-slate-200"
    />
    <button
      id="add-spot-btn"
      type="submit"
      aria-label="追加"
      title="追加"
      class="flex h-[38px] w-[38px] shrink-0 items-center justify-center rounded-lg bg-slate-900 text-white transition-all duration-75 hover:bg-slate-800 active:scale-95 cursor-pointer shadow-xs"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
        <circle cx="12" cy="10" r="3"/>
      </svg>
    </button>
  </div>

  <div class="mt-2 flex items-center gap-x-3 sm:gap-x-4 min-h-[28px] overflow-x-auto">
    <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-medium text-slate-600 hover:text-slate-900 select-none shrink-0 h-5">
      <input
        type="checkbox"
        id="add-type-departure"
        class="h-3.5 w-3.5 rounded border-slate-300 text-slate-900 focus:ring-slate-400 cursor-pointer accent-slate-900"
      />
      <span>発着地点</span>
    </label>
    <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-medium text-slate-600 hover:text-slate-900 select-none shrink-0 h-5">
      <input
        type="checkbox"
        id="add-type-accommodation"
        class="h-3.5 w-3.5 rounded border-slate-300 text-slate-900 focus:ring-slate-400 cursor-pointer accent-slate-900"
      />
      <span>宿泊地</span>
    </label>

    <span id="add-type-default-hint" class="text-[11px] text-slate-400 select-none shrink-0">（未選択時はスポット）</span>

    <!-- 発着地点クリック時の追加UI: 同じ行の右側に表示 -->
    <span id="add-type-note" class="hidden text-[11px] text-slate-500 select-none shrink-0">後から上書きできます。</span>

    <!-- 宿泊地クリック時の追加UI: 同じ行の右側にコンパクトに表示（カードの高さ変動を防止） -->
    <div id="add-accommodation-scope" class="hidden items-center gap-1.5 shrink-0" role="group" aria-label="宿泊地の反映範囲">
      <span class="text-[11px] text-slate-500 select-none">反映範囲:</span>
      <button
        id="add-accommodation-scope-all"
        type="button"
        class="inline-flex items-center justify-center h-[22px] rounded border border-slate-300 bg-white px-1.5 text-[11px] font-medium leading-none text-slate-700 cursor-pointer transition-colors hover:bg-slate-50"
      >
        以降すべて
      </button>
      <button
        id="add-accommodation-scope-today"
        type="button"
        class="inline-flex items-center justify-center h-[22px] rounded border border-slate-300 bg-white px-1.5 text-[11px] font-medium leading-none text-slate-700 cursor-pointer transition-colors hover:bg-slate-50"
      >
        当日のみ
      </button>
    </div>
  </div>
</form>

