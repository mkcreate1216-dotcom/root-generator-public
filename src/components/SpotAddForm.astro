---
---

<form
  id="add-spot-form"
  class="sticky top-0 z-30 mb-2 rounded-xl border border-slate-200/60 p-3 shadow-sm backdrop-blur-md sm:p-3.5"
  style="background-color: rgba(255, 255, 255, 0.95)"
>
  <div class="relative mb-2" id="trip-combobox-container">
    <label class="text-xs font-medium text-slate-500" for="trip-name-input">旅行名</label>
    <div class="relative mt-0.5 flex items-center">
      <input
        id="trip-name-input"
        type="text"
        placeholder="旅行名を入力"
        class="w-full rounded-lg border border-slate-300 bg-white py-1.5 pl-3 pr-9 text-sm font-bold text-slate-900 outline-none transition focus:border-slate-900 focus:ring-2 focus:ring-slate-200"
      />
      <button
        id="trip-combobox-toggle"
        type="button"
        aria-label="旅行一覧を表示"
        aria-haspopup="listbox"
        aria-expanded="false"
        class="absolute right-1 top-1/2 -translate-y-1/2 rounded-md p-1.5 text-slate-400 transition-colors duration-75 hover:bg-slate-100 hover:text-slate-700 cursor-pointer"
      >
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </button>
    </div>
    <ul
      id="trip-combobox-menu"
      role="listbox"
      class="absolute left-0 right-0 z-50 mt-1 hidden max-h-60 overflow-y-auto rounded-lg border border-slate-200 bg-white py-1 shadow-lg"
    ></ul>
  </div>

  <label class="mb-1.5 block text-xs font-medium text-slate-700" for="new-spot-input">スポット・地点を追加</label>
  <div class="flex flex-wrap items-center gap-2">
    <input
      id="new-spot-input"
      type="text"
      placeholder="例: 浅草寺"
      class="min-w-[12rem] flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none transition-colors duration-75 focus:border-slate-900 focus:ring-2 focus:ring-slate-200"
    />
    <div class="flex items-center gap-2">
      <select
        id="add-location-type-select"
        aria-label="追加する地点の種類"
        class="shrink-0 min-w-0 w-24 sm:w-28 rounded-lg border border-slate-300 bg-white px-2 py-2 text-xs font-medium text-slate-700 outline-none transition-colors duration-75 focus:border-slate-900 focus:ring-2 focus:ring-slate-200 sm:px-2.5 sm:text-sm cursor-pointer"
      >
        <option value="spot">スポット</option>
        <option value="departure">発着地点</option>
        <option value="accommodation">宿泊地</option>
      </select>
      <button
        id="add-spot-btn"
        type="submit"
        class="shrink-0 rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white transition-colors duration-75 hover:bg-slate-800 sm:px-4 cursor-pointer"
      >
        追加
      </button>
    </div>
  </div>
  <p id="add-type-note" class="mt-2 hidden text-xs text-slate-500"></p>
  <div id="add-accommodation-scope" class="mt-2 hidden flex flex-wrap items-center gap-2" role="group" aria-label="宿泊地の反映範囲">
    <span class="text-xs text-slate-500">反映範囲:</span>
    <button id="add-accommodation-scope-all" type="button" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 cursor-pointer">以降すべて</button>
    <button id="add-accommodation-scope-today" type="button" class="rounded-lg border border-slate-300 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 cursor-pointer">当日のみ</button>
  </div>
</form>

