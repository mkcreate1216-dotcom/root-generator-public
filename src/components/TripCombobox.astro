---
---

<div class="relative w-full max-w-xl mx-auto transition-all duration-300" id="trip-combobox-container">
  <!-- 角丸ボックス型の旅行名入力UI -->
  <div id="trip-name-line" class="relative flex items-center w-full rounded-2xl clay-input px-4 py-2.5 sm:px-5 sm:py-3 transition-all duration-200">
    <!-- タイトル入力欄 -->
    <input
      id="trip-name-input"
      type="text"
      placeholder="旅行のタイトルを入力"
      autocomplete="off"
      class="w-full border-none bg-transparent py-0 pl-1 pr-10 text-left text-xl sm:text-2xl font-bold text-slate-900 placeholder:text-slate-400 placeholder:font-normal outline-none focus:outline-none focus:ring-0 tracking-tight"
    />

    <!-- 右端: 過去の旅行一覧を開くドロップダウントグル -->
    <button
      id="trip-combobox-toggle"
      type="button"
      aria-label="旅行一覧を表示"
      aria-haspopup="listbox"
      aria-expanded="false"
      class="absolute right-2.5 sm:right-3.5 top-1/2 -translate-y-1/2 flex items-center justify-center rounded-full clay-btn p-1.5 text-slate-500 hover:text-slate-800 cursor-pointer shrink-0"
      title="保存した旅程一覧"
    >
      <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m6 9 6 6 6-6"/>
      </svg>
    </button>
  </div>

  <!-- ドロップダウンメニュー -->
  <ul
    id="trip-combobox-menu"
    role="listbox"
    class="absolute left-0 right-0 z-50 mt-2 hidden max-h-60 overflow-y-auto rounded-2xl clay-card p-2 space-y-1"
  ></ul>

  <!-- タイトル入力欄の下の「はじめる」ボタン -->
  <div id="trip-confirm-container" class="mt-5 flex justify-center">
    <button
      id="trip-confirm-btn"
      type="button"
      class="clay-btn-dark rounded-2xl px-10 py-3 text-base font-bold shadow-md cursor-pointer"
    >
      はじめる
    </button>
  </div>
</div>
