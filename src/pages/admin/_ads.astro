    // プレビューの描画とアニメーションセットアップ
    function renderPreview() {
      const container = document.getElementById('preview-container');
      const sizeBadge = document.getElementById('preview-size-badge');
      if (!container) return;

      if (previewTimerId) {
        clearInterval(previewTimerId);
        previewTimerId = null;
      }

      const placement = currentConfig.placements[activePreviewSlot];
      if (!placement) {
        container.innerHTML = `<div class="text-center py-8 text-xs text-slate-400">掲載枠が選択されていません。</div>`;
        return;
      }

      if (sizeBadge) {
        sizeBadge.textContent = `${placement.maxWidth}×${placement.maxHeight} px`;
      }

      if (!placement.enabled) {
        container.innerHTML = `
          <div class="text-center py-8 text-xs text-slate-400">
            この枠「${placement.name}」は現在「非表示（OFF）」に設定されています。
          </div>
        `;
        return;
      }

      const itemsMap = new Map(currentConfig.items.map((i) => [i.id, i]));
      const activeAds = placement.adIds
        .map((id) => itemsMap.get(id))
        .filter((item): item is AdItem => Boolean(item && item.active));

      if (activeAds.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-xs text-slate-400">
            表示可能な有効な広告が選択されていません。
          </div>
        `;
        return;
      }

      const hasMultiple = activeAds.length > 1;
      const maxWidth = placement.maxWidth || 320;
      const maxHeight = placement.maxHeight || 60;

      container.innerHTML = `
        <aside class="w-full max-w-5xl mx-auto pt-2 pb-0 border-t border-slate-200/80 select-none">
          <div
            class="flex items-center justify-between gap-2 mb-2 px-1 text-slate-400 text-[11px] font-medium mx-auto"
            style="max-width: ${maxWidth + (hasMultiple ? 80 : 0)}px;"
          >
            <div class="flex items-center gap-1.5 truncate">
              <span aria-hidden="true" class="text-xs shrink-0">${placement.icon}</span>
              <span class="truncate">${placement.label}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              ${
                hasMultiple
                  ? `
                <div class="flex items-center gap-1" id="sim-dots">
                  ${activeAds
                    .map(
                      (_, idx) => `
                    <button
                      type="button"
                      data-sim-dot="${idx}"
                      class="w-2 h-2 rounded-full transition-all p-0 border-0 cursor-pointer ${idx === 0 ? 'bg-slate-400' : 'bg-slate-200'}"
                    ></button>
                  `
                    )
                    .join('')}
                </div>
              `
                  : ''
              }
              <span class="text-[10px] tracking-wider text-slate-500 font-bold bg-slate-200/70 px-1.5 py-0.5 rounded">PR</span>
            </div>
          </div>

          <div class="flex items-center justify-center gap-1.5 sm:gap-3 w-full">
            ${
              hasMultiple
                ? `
              <button
                type="button"
                id="sim-prev-btn"
                class="shrink-0 w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200/80 active:scale-95 text-slate-500 hover:text-slate-800 transition-all border border-slate-200/60 shadow-xs cursor-pointer focus:outline-none"
              >
                <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m15 18-6-6 6-6"/></svg>
              </button>
            `
                : '<div class="w-7 sm:w-8 shrink-0"></div>'
            }

            <div
              id="sim-rotator"
              class="relative w-full overflow-hidden rounded bg-transparent shrink flex items-center justify-center"
              style="max-width: ${maxWidth}px; height: ${maxHeight}px;"
            >
              ${activeAds
                .map(
                  (ad, idx) => `
                <div
                  class="sim-slide absolute inset-0 flex items-center justify-center transition-opacity duration-700 ${idx === 0 ? 'opacity-100 z-10' : 'opacity-0 pointer-events-none z-0'}"
                  data-sim-index="${idx}"
                >
                  <a href="${ad.linkUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center max-w-full max-h-full transition-opacity hover:opacity-80">
                    <img src="${ad.imageUrl}" alt="${ad.alt}" width="${ad.width}" height="${ad.height}" class="rounded max-w-full max-h-full object-contain block" />
                  </a>
                </div>
              `
                )
                .join('')}
            </div>

            ${
              hasMultiple
                ? `
              <button
                type="button"
                id="sim-next-btn"
                class="shrink-0 w-7 h-7 sm:w-8 sm:h-8 flex items-center justify-center rounded-full bg-slate-100 hover:bg-slate-200/80 active:scale-95 text-slate-500 hover:text-slate-800 transition-all border border-slate-200/60 shadow-xs cursor-pointer focus:outline-none"
              >
                <svg class="w-3.5 h-3.5 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m9 18 6-6-6-6"/>
                </svg>
              </button>
            `
                : '<div class="w-7 sm:w-8 shrink-0"></div>'
            }
          </div>
        </aside>
      `;

      if (!hasMultiple) return;

      previewCurrentIndex = 0;
      const slides = container.querySelectorAll<HTMLElement>('.sim-slide');
      const dots = container.querySelectorAll<HTMLElement>('[data-sim-dot]');
      const prevBtn = container.querySelector<HTMLElement>('#sim-prev-btn');
      const nextBtn = container.querySelector<HTMLElement>('#sim-next-btn');
      const rotator = container.querySelector<HTMLElement>('#sim-rotator');

      function showSlide(index: number) {
        slides.forEach((slide, i) => {
          const isActive = i === index;
          slide.classList.toggle('opacity-100', isActive);
          slide.classList.toggle('opacity-0', !isActive);
          slide.classList.toggle('pointer-events-none', !isActive);
          slide.classList.toggle('z-10', isActive);
          slide.classList.toggle('z-0', !isActive);
        });

        dots.forEach((dot, i) => {
          const isActive = i === index;
          dot.classList.toggle('bg-slate-400', isActive);
          dot.classList.toggle('bg-slate-200', !isActive);
        });

        previewCurrentIndex = index;
      }

      function nextSlide() {
        const next = (previewCurrentIndex + 1) % slides.length;
        showSlide(next);
      }

      function prevSlide() {
        const prev = (previewCurrentIndex - 1 + slides.length) % slides.length;
        showSlide(prev);
      }

      function startTimer() {
        stopTimer();
        previewTimerId = setInterval(nextSlide, 6000);
      }

      function stopTimer() {
        if (previewTimerId) {
          clearInterval(previewTimerId);
          previewTimerId = null;
        }
      }

      if (nextBtn) {
        nextBtn.onclick = (e) => {
          e.stopPropagation();
          nextSlide();
          startTimer();
        };
      }
      if (prevBtn) {
        prevBtn.onclick = (e) => {
          e.stopPropagation();
          prevSlide();
          startTimer();
        };
      }
      dots.forEach((dot, idx) => {
        dot.onclick = (e) => {
          e.stopPropagation();
          showSlide(idx);
          startTimer();
        };
      });

      if (rotator) {
        rotator.onmouseenter = stopTimer;
        rotator.onmouseleave = startTimer;
      }

      startTimer();
    }

    // TypeScriptコードのエクスポート生成
    function renderExportCode() {
      const codeContainer = document.getElementById('code-output');
      if (!codeContainer) return;

      const codeString = `/**
 * 広告および掲載枠の設定管理
 * /admin/ads ページで設定コードを生成し、このファイルにペーストして更新できます。
 */

export type AdCategory = 'hotel' | 'car' | 'activity' | 'wifi' | 'other';

export interface AdItem {
  id: string;
  name: string;
  category: AdCategory;
  linkUrl: string;
  imageUrl: string;
  width: number;
  height: number;
  alt: string;
  trackingPixelUrl?: string;
  active: boolean;
}

export type AdSlotSize = 'compact' | 'medium' | 'rectangle' | 'leaderboard' | 'custom';

export const AD_SIZE_PRESETS: Record<AdSlotSize, { label: string; width: number; height: number }> = {
  compact: { label: 'コンパクト (320×60)', width: 320, height: 60 },
  medium: { label: 'モバイルラージ (320×100)', width: 320, height: 100 },
  rectangle: { label: 'レクタングル (300×250)', width: 300, height: 250 },
  leaderboard: { label: 'リーダーボード (728×90)', width: 728, height: 90 },
  custom: { label: 'カスタム', width: 320, height: 60 },
};

export type AdPlacementId = 'itinerary_bottom' | 'footer_top' | 'lp_hero_bottom' | (string & {});

export interface AdPlacementConfig {
  id: string;
  name: string;
  description: string;
  enabled: boolean;
  label: string;
  icon: string;
  sizePreset: AdSlotSize;
  maxWidth: number;
  maxHeight: number;
  adIds: string[];
}

export interface AdsConfiguration {
  items: AdItem[];
  placements: Record<string, AdPlacementConfig>;
}

export const adsConfig: AdsConfiguration = ${JSON.stringify(currentConfig, null, 2)};

/**
 * 指定した掲載枠に表示すべき有効な広告アイテムのリストを取得します。
 */
export function getAdsForPlacement(placementId: string): {
  placement: AdPlacementConfig | null;
  ads: AdItem[];
} {
  const placement = adsConfig.placements[placementId];
  if (!placement || !placement.enabled) {
    return { placement: null, ads: [] };
  }

  const itemsMap = new Map(adsConfig.items.map((item) => [item.id, item]));
  const ads = placement.adIds
    .map((id) => itemsMap.get(id))
    .filter((item): item is AdItem => Boolean(item && item.active));

  return { placement, ads };
}
`;

      codeContainer.textContent = codeString;
    }

