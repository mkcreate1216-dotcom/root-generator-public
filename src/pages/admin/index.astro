---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const envAdminKey =
  Astro.locals.runtime?.env?.ADMIN_PASSWORD ||
  Astro.locals.runtime?.env?.ADMIN_KEY ||
  'tabirome-dev-2026';

const cookieSession = Astro.cookies.get('tabirome_admin_session')?.value;
const queryKey = Astro.url.searchParams.get('key');
const isLogout = Astro.url.searchParams.get('logout') === '1';

// ログアウト処理
if (isLogout) {
  Astro.cookies.delete('tabirome_admin_session', { path: '/' });
  return Astro.redirect('/admin');
}

let isAuthenticated = false;
let loginError = '';

// POSTでのログイン試行
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const inputPassword = formData.get('password');
    if (typeof inputPassword === 'string' && inputPassword.trim() === envAdminKey.trim()) {
      Astro.cookies.set('tabirome_admin_session', envAdminKey, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        maxAge: 60 * 60 * 24 * 7, // 7日間保持
      });
      return Astro.redirect('/admin');
    } else {
      loginError = 'パスワードが正しくありません。';
    }
  } catch (e) {
    loginError = 'ログイン処理中にエラーが発生しました。';
  }
}

// 認証チェック
if (cookieSession === envAdminKey || queryKey === envAdminKey) {
  isAuthenticated = true;
  if (queryKey === envAdminKey && !cookieSession) {
    Astro.cookies.set('tabirome_admin_session', envAdminKey, {
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });
  }
}

// 集計データ
interface DailyView {
  view_date: string;
  count: number;
}
interface TopPath {
  path: string;
  count: number;
}
interface DeviceStat {
  device_type: string;
  count: number;
}
interface PlanSummary {
  version: number;
  created_at: string;
  updated_at: string;
}
interface McpTokenSummary {
  token_prefix: string;
  created_at: string;
  last_used_at: string | null;
  request_count_today: number;
  request_count_total: number;
}

interface DailyPlan {
  view_date: string;
  count: number;
}

let totalPv = 0;
let todayPv = 0;
let yesterdayPv = 0;
let dailyViews: DailyView[] = [];
let topPaths: TopPath[] = [];
let deviceStats: DeviceStat[] = [];
let totalPlans = 0;
let todayPlans = 0;
let recentPlans: PlanSummary[] = [];
let totalMcpTokens = 0;
let totalMcpRequests = 0;
let todayMcpRequests = 0;
let mcpTokens: McpTokenSummary[] = [];
let dailyPlans: DailyPlan[] = [];
let last7Plans = 0;
let prev7Plans = 0;
let plansGrowthPct = 0;

if (isAuthenticated && db) {
  try {
    // 1. PV統計
    const totalPvRow = await db
      .prepare(`SELECT COUNT(*) as c FROM page_views`)
      .first<{ c: number }>();
    totalPv = totalPvRow?.c || 0;

    const todayPvRow = await db
      .prepare(`SELECT COUNT(*) as c FROM page_views WHERE view_date = date('now', 'localtime')`)
      .first<{ c: number }>();
    todayPv = todayPvRow?.c || 0;

    const yesterdayPvRow = await db
      .prepare(`SELECT COUNT(*) as c FROM page_views WHERE view_date = date('now', '-1 day', 'localtime')`)
      .first<{ c: number }>();
    yesterdayPv = yesterdayPvRow?.c || 0;

    // 2. 直近14日間の日別推移
    const dailyResult = await db
      .prepare(
        `SELECT view_date, COUNT(*) as count 
         FROM page_views 
         WHERE view_date >= date('now', '-13 day', 'localtime')
         GROUP BY view_date 
         ORDER BY view_date ASC`
      )
      .all<DailyView>();
    dailyViews = dailyResult.results || [];

    // 3. 人気パスランキング（トップ8）
    // 保存済みの /p/{id} を /p に書き換えてから集計する。IDは共有ページの閲覧鍵になる。
    await db.prepare(
      `UPDATE page_views SET path = '/p' WHERE path LIKE '/p/%' OR path LIKE '/p?%'`
    ).run();
    await db.prepare(
      `UPDATE page_views
       SET referer = substr(referer, 1, instr(referer, '/p/') + 1)
       WHERE referer LIKE ?`
    )
      .bind(`${Astro.url.origin}/p/%`)
      .run();
    const topPathsResult = await db
      .prepare(
        `SELECT
           CASE
             WHEN path = '/p' OR path LIKE '/p/%' OR path LIKE '/p?%' THEN '/p'
             ELSE path
           END AS path,
           COUNT(*) as count
         FROM page_views
         GROUP BY 1
         ORDER BY count DESC
         LIMIT 8`
      )
      .all<TopPath>();
    topPaths = topPathsResult.results || [];

    // 4. デバイス別集計
    const devicesResult = await db
      .prepare(`SELECT device_type, COUNT(*) as count FROM page_views GROUP BY device_type`)
      .all<DeviceStat>();
    deviceStats = devicesResult.results || [];

    // 5. 旅程プラン統計
    const plansCountRow = await db
      .prepare(`SELECT COUNT(*) as c FROM plans`)
      .first<{ c: number }>();
    totalPlans = plansCountRow?.c || 0;

    const todayPlansRow = await db
      .prepare(`SELECT COUNT(*) as c FROM plans WHERE date(created_at) = date('now', 'localtime')`)
      .first<{ c: number }>();
    todayPlans = todayPlansRow?.c || 0;

    const recentPlansResult = await db
      .prepare(
        `SELECT version, created_at, updated_at 
         FROM plans 
         ORDER BY updated_at DESC 
         LIMIT 6`
      )
      .all<PlanSummary>();
    recentPlans = recentPlansResult.results || [];

    // 7. プラン作成推移（利用者成長の指標）
    const dailyPlansResult = await db
      .prepare(
        `SELECT date(created_at) as view_date, COUNT(*) as count
         FROM plans
         WHERE date(created_at) >= date('now', '-29 day', 'localtime')
         GROUP BY date(created_at)
         ORDER BY view_date ASC`
      )
      .all<DailyPlan>();
    dailyPlans = dailyPlansResult.results || [];

    const last7Row = await db
      .prepare(`SELECT COUNT(*) as c FROM plans WHERE date(created_at) >= date('now', '-6 day', 'localtime')`)
      .first<{ c: number }>();
    last7Plans = last7Row?.c || 0;

    const prev7Row = await db
      .prepare(`SELECT COUNT(*) as c FROM plans WHERE date(created_at) >= date('now', '-13 day', 'localtime') AND date(created_at) < date('now', '-6 day', 'localtime')`)
      .first<{ c: number }>();
    prev7Plans = prev7Row?.c || 0;

    if (prev7Plans > 0) {
      plansGrowthPct = Math.round(((last7Plans - prev7Plans) / prev7Plans) * 100);
    } else if (last7Plans > 0) {
      plansGrowthPct = 100;
    }

    // 6. MCP統計
    const mcpCountRow = await db
      .prepare(`SELECT COUNT(*) as c FROM api_tokens`)
      .first<{ c: number }>();
    totalMcpTokens = mcpCountRow?.c || 0;

    const mcpRequestsRow = await db
      .prepare(
        `SELECT COALESCE(SUM(request_count_total), 0) as tot, COALESCE(SUM(request_count_today), 0) as tod 
         FROM api_tokens`
      )
      .first<{ tot: number; tod: number }>();
    totalMcpRequests = mcpRequestsRow?.tot || 0;
    todayMcpRequests = mcpRequestsRow?.tod || 0;

    const mcpTokensResult = await db
      .prepare(
        `SELECT token_prefix, created_at, last_used_at, request_count_today, request_count_total 
         FROM api_tokens 
         ORDER BY created_at DESC 
         LIMIT 5`
      )
      .all<McpTokenSummary>();
    mcpTokens = mcpTokensResult.results || [];
  } catch (err) {
    console.error('Error fetching admin dashboard data:', err);
  }
}

// グラフ描画用の最大値計算
const maxDailyCount = Math.max(1, ...dailyViews.map((d) => d.count));

const maxDailyPlans = Math.max(1, ...dailyPlans.map((d) => d.count));

// 累積プラン計算
let cumulative = 0;
const cumulativePlans = dailyPlans.map((d) => {
  cumulative += d.count;
  return { ...d, cumulative };
});
const maxCumulative = Math.max(1, ...cumulativePlans.map((d) => d.cumulative));

// デバイス割合計算
const totalDeviceCount = deviceStats.reduce((sum, d) => sum + d.count, 0) || 1;
const mobileCount = deviceStats.find((d) => d.device_type === 'mobile')?.count || 0;
const desktopCount = deviceStats.find((d) => d.device_type === 'desktop')?.count || 0;
const tabletCount = deviceStats.find((d) => d.device_type === 'tablet')?.count || 0;
const mobilePct = Math.round((mobileCount / totalDeviceCount) * 100);
const desktopPct = Math.round((desktopCount / totalDeviceCount) * 100);
const tabletPct = 100 - mobilePct - desktopPct;
---

<Layout title="開発者ダッシュボード | たびろーむ" showFooterAd={false}>
  <head slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </head>

  <div class="max-w-6xl mx-auto px-3 sm:px-4 py-6 overflow-x-hidden">
    {!isAuthenticated ? (
      <!-- ログイン画面 -->
      <div class="min-h-[70vh] flex items-center justify-center">
        <div class="clay-card w-full max-w-md p-6 sm:p-8 text-center">
          <div class="h-12 w-12 rounded-2xl bg-slate-900 text-white flex items-center justify-center mx-auto mb-4 text-xl shadow-md">
            🔒
          </div>
          <h1 class="text-xl font-bold text-slate-800 mb-2">開発者専用ダッシュボード</h1>
          <p class="text-xs text-slate-500 mb-6">閲覧数・プラン作成状況・MCP利用状況を可視化します。</p>

          {loginError && (
            <div class="mb-4 rounded-xl bg-red-50 p-3 text-xs text-red-600 border border-red-200">
              {loginError}
            </div>
          )}

          <form method="POST" class="space-y-4">
            <div class="text-left">
              <label for="admin-password" class="block text-xs font-semibold text-slate-700 mb-1.5">
                アクセスキー / パスワード
              </label>
              <input
                id="admin-password"
                name="password"
                type="password"
                required
                placeholder="開発者パスワードを入力"
                class="w-full clay-input px-3.5 py-2.5 text-sm outline-none"
              />
            </div>
            <button
              type="submit"
              class="w-full py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all shadow-md active:scale-95 cursor-pointer"
            >
              ログインしてダッシュボードを開く
            </button>
          </form>

          <p class="mt-6 text-[11px] text-slate-400">
            ※ 環境変数 <code class="bg-slate-100 px-1 py-0.5 rounded font-mono">ADMIN_PASSWORD</code> で認証キーを設定できます。
          </p>
        </div>
      </div>
    ) : (
      <!-- ダッシュボード本体 -->
      <div>
        <!-- ヘッダーナビゲーション -->
        <header class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="text-xs font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 tracking-wide uppercase">
                Developer Admin
              </span>
              <span class="text-xs text-slate-400">リアルタイム稼働分析</span>
            </div>
            <h1 class="text-2xl font-black text-slate-800 tracking-tight">たびろーむ 開発者ダッシュボード</h1>
            <p class="text-xs text-slate-500 mt-1">
              利用者（プラン作成）の増加推移と、サイトの利用状況を可視化しています。
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            <a
              href="/admin/ads"
              class="clay-btn text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-600 hover:text-slate-900 inline-flex items-center gap-1.5 transition-all"
            >
              <span>📢</span>
              広告枠設定
            </a>
            <a
              href="/"
              target="_blank"
              rel="noopener noreferrer"
              class="clay-btn text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-600 hover:text-slate-900 inline-flex items-center gap-1.5 transition-all"
            >
              <span>🌐</span>
              サイトを開く
            </a>
            <a
              href="/admin?logout=1"
              class="clay-btn text-xs font-medium px-3 py-1.5 rounded-xl text-red-600 hover:text-red-700 transition-all"
            >
              ログアウト
            </a>
          </div>
        </header>

        <!-- KPIサマリーカード群 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 mb-6">
          <!-- 累計閲覧数 -->
          <div class="clay-card p-4 sm:p-5">
            <div class="flex items-center justify-between text-slate-500 text-xs font-medium mb-2">
              <span>👀 累計閲覧数 (PV)</span>
              <span class="text-[10px] bg-slate-100 px-1.5 py-0.5 rounded text-slate-600">全期間</span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-slate-800 mb-1">{totalPv.toLocaleString()}</div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1">
              <span>本日:</span>
              <span class="font-bold text-emerald-600">+{todayPv.toLocaleString()}</span>
              <span class="text-slate-400">(昨日: {yesterdayPv.toLocaleString()})</span>
            </div>
          </div>

          <!-- 保存された旅程数（利用者数の指標） -->
          <div class="clay-card p-4 sm:p-5">
            <div class="flex items-center justify-between text-slate-500 text-xs font-medium mb-2">
              <span>🗺️ 累計プラン（利用者）</span>
              <span class="text-[10px] bg-indigo-50 px-1.5 py-0.5 rounded text-indigo-600 font-semibold">作成数</span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-slate-800 mb-1">{totalPlans.toLocaleString()}</div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1">
              <span>本日:</span>
              <span class="font-bold text-indigo-600">+{todayPlans.toLocaleString()}</span>
              <span class="text-slate-400">/ 7日: {last7Plans}</span>
            </div>
          </div>

          <!-- MCP連携API利用数 -->
          <div class="clay-card p-4 sm:p-5">
            <div class="flex items-center justify-between text-slate-500 text-xs font-medium mb-2">
              <span>🤖 MCPリクエスト</span>
              <span class="text-[10px] bg-amber-50 px-1.5 py-0.5 rounded text-amber-700 font-semibold">AI連携</span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-slate-800 mb-1">{totalMcpRequests.toLocaleString()}</div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1">
              <span>トークン数:</span>
              <span class="font-bold text-slate-700">{totalMcpTokens}件</span>
              <span class="text-slate-400">(本日: {todayMcpRequests})</span>
            </div>
          </div>

          <!-- モバイル閲覧割合 -->
          <div class="clay-card p-4 sm:p-5">
            <div class="flex items-center justify-between text-slate-500 text-xs font-medium mb-2">
              <span>📱 モバイル比率</span>
              <span class="text-[10px] bg-emerald-50 px-1.5 py-0.5 rounded text-emerald-700 font-semibold">端末比率</span>
            </div>
            <div class="text-2xl sm:text-3xl font-black text-slate-800 mb-1">{mobilePct}%</div>
            <div class="text-[11px] text-slate-500 flex items-center gap-1">
              <span>PC: {desktopPct}%</span>
              <span class="text-slate-300">/</span>
              <span>タブレット: {tabletPct}%</span>
            </div>
          </div>
        </div>

        <!-- 利用者成長セクション -->
        <div class="clay-card p-5 sm:p-6 mb-8">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
            <div>
              <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <span>📈</span>
                <span>利用者成長（プラン作成推移）</span>
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">実際に旅程を保存したユーザーの日次増加と累積</p>
            </div>
            <div class="flex items-center gap-4 text-xs">
              <div class="text-center">
                <div class="text-[10px] text-slate-500">直近7日</div>
                <div class="font-bold text-indigo-600 text-lg">{last7Plans}</div>
              </div>
              <div class="text-center">
                <div class="text-[10px] text-slate-500">前週</div>
                <div class="font-bold text-slate-600 text-lg">{prev7Plans}</div>
              </div>
              <div class="text-center">
                <div class="text-[10px] text-slate-500">前週比</div>
                <div class={`font-bold text-lg ${plansGrowthPct >= 0 ? 'text-emerald-600' : 'text-red-500'}`}>
                  {plansGrowthPct >= 0 ? '+' : ''}{plansGrowthPct}%
                </div>
              </div>
            </div>
          </div>

          {dailyPlans.length === 0 ? (
            <div class="h-36 flex items-center justify-center text-xs text-slate-400 border border-dashed border-slate-200 rounded-2xl">
              まだプラン作成データがありません。
            </div>
          ) : (
            <div>
              <div class="h-36 flex items-end gap-1 sm:gap-1.5 border-b border-slate-200 pb-2 overflow-x-auto">
                {dailyPlans.map((item) => {
                  const heightPercent = Math.max(6, Math.round((item.count / maxDailyPlans) * 100));
                  const isToday = item.view_date === new Date().toISOString().slice(0, 10);
                  return (
                    <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group relative min-w-[1.2rem]">
                      <div class="absolute -top-7 bg-slate-900 text-white text-[9px] font-mono px-1.5 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-10 shadow">
                        {item.view_date.slice(5)}: {item.count}件
                      </div>
                      <div
                        style={`height: ${heightPercent}%;`}
                        class={`w-full rounded-t transition-all duration-300 ${isToday ? 'bg-indigo-600' : 'bg-indigo-400'}`}
                      />
                      <span class="text-[8px] sm:text-[9px] font-mono text-slate-400 truncate w-full text-center">
                        {item.view_date.slice(5)}
                      </span>
                    </div>
                  );
                })}
              </div>
              <div class="flex items-center justify-between text-[10px] text-slate-400 mt-2">
                <span>直近30日の新規プラン作成数</span>
                <span>累計: {totalPlans.toLocaleString()} 件</span>
              </div>
            </div>
          )}
        </div>

        <!-- メイングリッド: 日別チャート & デバイス・ランキング -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mb-8">
          <!-- 左側: 直近14日間の日別PV推移バーチャート (8カラム) -->
          <div class="lg:col-span-8 clay-card p-5 sm:p-6">
            <div class="flex items-center justify-between mb-6">
              <div>
                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                  <span>📊</span>
                  <span>日別閲覧数 (直近14日間)</span>
                </h2>
                <p class="text-xs text-slate-400 mt-0.5">日ごとのページビュー推移</p>
              </div>
              <span class="text-xs font-mono text-slate-400 bg-slate-50 px-2.5 py-1 rounded-lg border border-slate-100">
                MAX: {maxDailyCount} PV
              </span>
            </div>

            {dailyViews.length === 0 ? (
              <div class="h-48 flex items-center justify-center text-xs text-slate-400 border border-dashed border-slate-200 rounded-2xl">
                まだ記録された閲覧データがありません。サイトを巡回するとここに棒グラフが表示されます。
              </div>
            ) : (
              <div class="pt-4">
                <div class="h-40 sm:h-44 flex items-end gap-1 sm:gap-2 border-b border-slate-200 pb-2 overflow-x-auto">
                  {dailyViews.map((item) => {
                    const heightPercent = Math.max(8, Math.round((item.count / maxDailyCount) * 100));
                    const isToday = item.view_date === new Date().toISOString().slice(0, 10);
                    return (
                      <div class="flex-1 flex flex-col items-center gap-1 h-full justify-end group relative min-w-[1.5rem]">
                        <!-- ツールチップ -->
                        <div class="absolute -top-8 bg-slate-900 text-white text-[10px] font-mono px-2 py-0.5 rounded opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap z-10 shadow">
                          {item.view_date}: {item.count} PV
                        </div>
                        <div
                          style={`height: ${heightPercent}%;`}
                          class={`w-full rounded-t-lg transition-all duration-300 group-hover:brightness-95 ${
                            isToday ? 'bg-indigo-600' : 'bg-slate-300'
                          }`}
                        />
                        <span class="text-[9px] sm:text-[10px] font-mono text-slate-400 truncate w-full text-center">
                          {item.view_date.slice(5)}
                        </span>
                      </div>
                    );
                  })}
                </div>
                <div class="flex items-center justify-between text-[11px] text-slate-400 mt-2 px-1">
                  <span>14日前</span>
                  <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-1">
                      <span class="h-2 w-2 rounded-full bg-slate-300"></span>過去日
                    </span>
                    <span class="inline-flex items-center gap-1">
                      <span class="h-2 w-2 rounded-full bg-indigo-600"></span>本日
                    </span>
                  </div>
                  <span>今日</span>
                </div>
              </div>
            )}
          </div>

          <!-- 右側: デバイス割合 & 人気ページランキング (4カラム) -->
          <div class="lg:col-span-4 space-y-6">
            <!-- デバイス割合バー -->
            <div class="clay-card p-5">
              <h2 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-1.5">
                <span>📱</span>
                <span>アクセス端末の内訳</span>
              </h2>
              <div class="h-4 w-full rounded-full bg-slate-100 flex overflow-hidden mb-3">
                <div style={`width: ${mobilePct}%;`} class="bg-emerald-500 h-full" title={`モバイル: ${mobilePct}%`}></div>
                <div style={`width: ${desktopPct}%;`} class="bg-indigo-500 h-full" title={`PC: ${desktopPct}%`}></div>
                <div style={`width: ${tabletPct}%;`} class="bg-amber-400 h-full" title={`タブレット: ${tabletPct}%`}></div>
              </div>
              <div class="grid grid-cols-3 gap-1.5 sm:gap-2 text-center text-xs">
                <div class="rounded-xl bg-emerald-50/70 p-2 border border-emerald-100/50">
                  <div class="text-[10px] text-emerald-700 font-medium">スマホ</div>
                  <div class="font-bold text-emerald-900">{mobilePct}%</div>
                </div>
                <div class="rounded-xl bg-indigo-50/70 p-2 border border-indigo-100/50">
                  <div class="text-[10px] text-indigo-700 font-medium">PC</div>
                  <div class="font-bold text-indigo-900">{desktopPct}%</div>
                </div>
                <div class="rounded-xl bg-amber-50/70 p-2 border border-amber-100/50">
                  <div class="text-[10px] text-amber-700 font-medium">タブレット</div>
                  <div class="font-bold text-amber-900">{tabletPct}%</div>
                </div>
              </div>
            </div>

            <!-- 人気ページランキング -->
            <div class="clay-card p-5">
              <h2 class="text-sm font-bold text-slate-800 mb-3 flex items-center gap-1.5">
                <span>📈</span>
                <span>人気ページランキング</span>
              </h2>
              {topPaths.length === 0 ? (
                <p class="text-xs text-slate-400">まだデータがありません。</p>
              ) : (
                <div class="space-y-2">
                  {topPaths.map((p, i) => (
                    <div class="flex items-center justify-between text-xs">
                      <div class="flex items-center gap-2 min-w-0 flex-1">
                        <span class="text-slate-400 font-mono w-4">{i + 1}</span>
                        <span class="truncate font-medium text-slate-700">{p.path || '/'}</span>
                      </div>
                      <span class="font-bold text-slate-800 ml-2">{p.count} PV</span>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- 下部: 最近の旅程 & MCPトークン -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <!-- 最近の旅程プラン (6カラム) -->
          <div class="lg:col-span-6 clay-card p-5 sm:p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <span>🗺️</span>
                <span>最近の旅程プラン</span>
              </h2>
              <span class="text-xs text-slate-400">総数: {totalPlans}件</span>
            </div>
            {recentPlans.length === 0 ? (
              <p class="text-xs text-slate-400">保存されたプランはありません。</p>
            ) : (
              <div class="space-y-2.5">
                {recentPlans.map((p, i) => (
                  <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between gap-3 text-xs">
                    <div class="min-w-0 flex-1">
                      <span class="font-semibold text-slate-800 truncate block">
                        旅程プラン #{i + 1}（内容は非表示）
                      </span>
                      <div class="text-[10px] text-slate-400 font-mono mt-0.5">
                        v{p.version} · 更新: {p.updated_at}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <!-- MCP APIトークン & 連携状況 (6カラム) -->
          <div class="lg:col-span-6 clay-card p-5 sm:p-6">
            <div class="flex items-center justify-between mb-4">
              <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                <span>🤖</span>
                <span>MCP APIトークン利用状況</span>
              </h2>
              <span class="text-xs text-slate-400">総リクエスト: {totalMcpRequests}回</span>
            </div>
            {mcpTokens.length === 0 ? (
              <p class="text-xs text-slate-400">発行されたMCPトークンはありません。</p>
            ) : (
              <div class="space-y-2.5">
                {mcpTokens.map((t) => (
                  <div class="p-3 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between gap-3 text-xs">
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono font-bold text-slate-800">{t.token_prefix}••••••••</span>
                        <span class="text-[10px] bg-slate-200/80 px-1.5 py-0.2 rounded text-slate-600">
                          本日: {t.request_count_today}回
                        </span>
                      </div>
                      <div class="text-[10px] text-slate-400 font-mono mt-0.5">
                        作成: {t.created_at} · 累計: {t.request_count_total}回
                        {t.last_used_at ? ` · 最終: ${t.last_used_at}` : ''}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>
